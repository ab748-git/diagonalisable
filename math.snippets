global !p
def math():
    return vim.eval('vimtex#syntax#in_mathzone()') == '1'
endglobal

snippet mk "Math" wA
\$$1\$
endsnippet

snippet dm "Math" bA
\[
	${1:${VISUAL}}
\]
endsnippet

snippet ... "dots" iA
\ldots 
endsnippet

context "math()"
snippet c.. "center dots" wA
\cdots 
endsnippet

context "math()"
snippet // "Fraction" iA
\frac{$1}{$2}
endsnippet

context "math()"
snippet / "Fraction" i
\frac{${VISUAL}}{$1}
endsnippet

context "math()"
snippet '((\d+)|(\d*)(\\)?([A-Za-z]+)((\^|_)(\{\d+\}|\d))*)/' "symbol frac" wrA
\frac{`!p snip.rv = match.group(1)`}{$1}
endsnippet

context "math()"
snippet () "parentheses" i
\left( $1 \right) 
endsnippet

context "math()"
snippet [] "bracket" i
\left[ $1 \right] 
endsnippet

context "math()"
snippet sum "sum" w
\sum_{$1}
endsnippet

context "math()"
snippet dsum "definite sum" w
\sum_{${1:n=${2:1}}}^{${3:\infty}}
endsnippet

context "math()"
snippet limit "limit" w
\lim_{${1:n} \to ${2:\infty}} 
endsnippet

context "math()"
snippet dlim "direct limit" w
\varinjlim_{$1} 
endsnippet

context "math()"
snippet lim "categorical limit" w
\lim_{$1} 
endsnippet 

context "math()"
snippet colim "categorical colimit" w
\colim_{$1} 
endsnippet 

context "math()"
snippet ilim "inverse limit" w
\varprojlim_{$1} 
endsnippet

context "math()"
snippet prod "product" w
\prod_{$1} 
endsnippet

context "math()"
snippet dprod "definite product" w
\prod_{${1:n=${2:1}}} 
endsnippet

context "math()"
snippet coprod "coproduct" w
\coprod_{$1} 
endsnippet 

context "math()"
snippet SQ "square root" wA
\sqrt{${1:${VISUAL}}}
endsnippet

context "math()"
snippet int "integral" wA
\int_{$1} 
endsnippet

context "math()"
snippet dint "definite integral" w
\int_{${1:-\infty}}^{${2:\infty}} ${3:${VISUAL}}
endsnippet

context "math()"
snippet limsup "limsup" w
\limsup_{${1:n} \to ${2:\infty}} 
endsnippet

context "math()"
snippet liminf "liminf" w
\liminf_{${1:n} \to ${2:\infty}} 
endsnippet

context "math()"
snippet "(?<![a-zA-z]|\\)([a-zA-Z])bar" "bar" rA
\overline{`!p snip.rv=match.group(1)`}
endsnippet

context "math()"
snippet "(?<![a-zA-z]|\\)([a-zA-Z])~" "tilde" rA
\tilde{`!p snip.rv=match.group(1)`}
endsnippet

context "math()"
snippet hat "hat" wA
\hat{$1} 
endsnippet

context "math()"
snippet "(?<![a-zA-z]|\\)([a-zA-Z])\^" "hat" rA
\hat{`!p snip.rv=match.group(1)`}
endsnippet

context "math()"
snippet wt "wide tilde" w
\widetilde{${1:${VISUAL}}}
endsnippet

context "math()"
snippet wh "wide hat" w
\widehat{${1:${VISUAL}}}
endsnippet

context "math()"
snippet qd "space" wA
\qquad 
endsnippet
