snippet beg "begin{} / end{}" bA
\begin{${1:something}}
	${0:${VISUAL}}
\end{$1}
endsnippet

snippet today "Date" i
`date +"%b %d, %Y"`
endsnippet

snippet table "Table environment" b
\begin{table}[ht]
	\centering
	\begin{tabular}{${1:c}}
	$0
	\end{tabular}
\end{table}
endsnippet

snippet fig "Figure environment" b
\begin{figure}[ht]
	\centering
	\includegraphics[width=0.8\linewidth]{${1:name.ext}}
\end{figure}
endsnippet

snippet incfig "inkscape figure" b
\begin{figure}[ht]
	\centering
	\def\svgwidth{0.8\columnwidth}
	\input{./figures/${1:name}.pdf_tex}
\end{figure}
endsnippet

snippet enum "Enumerate" b
\begin{enumerate}[$1]
	\item $0
\end{enumerate}
endsnippet

snippet item "Itemize" b
\begin{itemize}
	\item $0
\end{itemize}
endsnippet

snippet it "Individual item" b
\item $0
endsnippet

snippet sec "Section" b
\section{${1:${VISUAL:section name}}}

endsnippet

snippet sub "Subsection" b
\subsection{${1:${VISUAL:subsection name}}}

endsnippet


snippet ssub "Subsubsection" b
\subsubsection{${1:${VISUAL:subsubsection name}}}

endsnippet

snippet par "Paragraph" b
\paragraph{${1:${VISUAL:paragraph name}}}

endsnippet

snippet subp "Subparagraph" b
\subparagraph{${1:${VISUAL:subparagraph name}}}

endsnippet

snippet ni "Non-indented paragraph" b
\noindent
endsnippet

snippet pac "Package" b
\usepackage`!p snip.rv='[' if t[1] else ""`${1:options}`!p snip.rv = ']' if t[1] else ""`{${2:package}}
endsnippet

snippet bf "Bold" w
\textbf{${1:${VISUAL}}}
endsnippet

snippet ita "Italics" w
\textit{${1:${VISUAL}}}
endsnippet

snippet und "Underline" w
\underline{${1:${VISUAL}}}
endsnippet

snippet tw "Typewriter" w
\texttt{${1:${VISUAL}}}
endsnippet

snippet sf "Serif" w
\textsf{${1:${VISUAL}}}
endsnippet

snippet emph "Emphasize" wA
\emph{${1:${VISUAL}}}
endsnippet

snippet cap "capation" w
\caption{${1:${VISUAL}}}
endsnippet

snippet lab "label" w
\label{${1:${VISUAL}}}
endsnippet
