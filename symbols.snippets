global !p
def math():
    return vim.eval('vimtex#syntax#in_mathzone()') == '1'
endglobal

context "math()"
snippet lll "l" w
\ell 
endsnippet

context "math()"
snippet VV "nabla" w
\nabla 
endsnippet

context "math()"
snippet xx "cross" wA
\times 
endsnippet

context "math()"
snippet ox "tensor" wA
\otimes
endsnippet

context "math()"
snippet o* "o dot" wA
\odot 
endsnippet

context "math()"
snippet o+ "direct sum" wA
\oplus 
endsnippet

context "math()"
snippet Ox "tensor" wA
\bigotimes_{$1} 
endsnippet

context "math()"
snippet O+ "direct sum" wA
\bigoplus_{$1} 
endsnippet

context "math()"
snippet ** "cdot" wA
\cdot 
endsnippet

context "math()"
snippet <= "leq" wA
\le 
endsnippet

context "math()"
snippet >= "geq" wA
\ge 
endsnippet

context "math()"
snippet >> ">>" wA
\gg 
endsnippet

context "math()"
snippet << "<<" wA
\ll 
endsnippet

context "math()"
snippet ~~ "~" wA
\sim 
endsnippet

context "math()"
snippet ~= "homotopy" wA
\simeq 
endsnippet

context "math()"
snippet || "mid" wA
\mid 
endsnippet

context "math()"
snippet cc "subset" w
\subset 
endsnippet

context "math()"
snippet ccc "subseteq" wA
\subseteq 
endsnippet

context "math()"
snippet !! "not" wA
\not 
endsnippet

context "math()"
snippet ccn "subsetneq" wA
\subsetneq 
endsnippet

context "math()"
snippet nin "not in " wA
\notin 
endsnippet

context "math()"
snippet inn "in " wA
\in 
endsnippet

context "math()"
snippet nn "cap" wA
\cap 
endsnippet

context "math()"
snippet uu "cup" wA
\cup 
endsnippet

context "math()"
snippet Uu "bigcup" w
\bigcup_{$1}
endsnippet

context "math()"
snippet Nn "bigcap" w
\bigcap_{$1}
endsnippet

context "math()"
snippet <! "normal" wA
\trianglelefteq 
endsnippet

context "math()"
snippet x| "semidirect product" w
\rtimes 
endsnippet
context "math()"
snippet |x "semidirect product" w
\ltimes 
endsnippet

context "math()"
snippet <> "hokje" w
\diamond 
endsnippet

context "math()"
snippet <3 "heart" w
\heartsuit 
endsnippet

context "math()"
snippet bs "boldsymbol" wA
\boldsymbol{$1}
endsnippet

context "math()"
snippet o "composite" w
\circ 
endsnippet

context "math()"
snippet * "bullet" w
\bullet
endsnippet
