global !p
def math():
    return vim.eval('vimtex#syntax#in_mathzone()') == '1'
endglobal

context "math()"
snippet '([A-Za-z])(\d)' "auto subscript" wrA
`!p snip.rv = match.group(1)`_`!p snip.rv = match.group(2)`
endsnippet

context "math()"
snippet '([A-Za-z])_(\d\d)' "auto subscript2" wrA
`!p snip.rv = match.group(1)`_{`!p snip.rv = match.group(2)`}
endsnippet

context "math()"
snippet __ "subscript" iA
_{$1}
endsnippet

context "math()"
snippet sub "subscript" wA
_{$1}
endsnippet

context "math()"
snippet push "postcomposition" iA
_{*}
endsnippet

context "math()"
snippet 'tsub' "text subscript" wrA
_\text{$1}
endsnippet

context "math()"
snippet cx "chain complex" iA
_{\bullet}
endsnippet

